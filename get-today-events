#!/usr/bin/env bash
# Emits the raw events.list JSON for the local calendar day (midnight to
# midnight, converted to UTC for the dcal query). The widget sorts and
# renders; on any failure emit an empty list so the popout shows a clean
# "no events" state instead of a parse error.
set -eu

FROM=$(date -u -d "today 00:00" +%Y-%m-%dT%H:%M:%SZ)
TO=$(date -u -d "tomorrow 00:00" +%Y-%m-%dT%H:%M:%SZ)

dcal ipc events.list from="${FROM}" to="${TO}" 2>/dev/null || echo '{"events":[]}'
