#!/usr/bin/env bash
# Emits the raw events.list JSON for a window of local calendar days:
# PAST_DAYS before today's local midnight through FUTURE_DAYS after it
# (converted to UTC — note `date -u -d` would parse the input as UTC too,
# so the conversion goes through an epoch). The widget groups and renders;
# on any failure emit an empty list so the popout shows a clean "no
# events" state.
set -eu

PAST_DAYS="${1:-14}"
FUTURE_DAYS="${2:-45}"

TODAY=$(date +%F)
START_DAY=$(date -d "${TODAY} -${PAST_DAYS} days" +%F)
END_DAY=$(date -d "${TODAY} +${FUTURE_DAYS} days" +%F)
FROM=$(date -u -d "@$(date -d "${START_DAY}" +%s)" +%Y-%m-%dT%H:%M:%SZ)
TO=$(date -u -d "@$(date -d "${END_DAY}" +%s)" +%Y-%m-%dT%H:%M:%SZ)

dcal ipc events.list from="${FROM}" to="${TO}" 2>/dev/null || echo '{"events":[]}'
