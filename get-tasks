#!/usr/bin/env python3
import subprocess
import json
import sys
import os
import sqlite3

def _get_created_map():
    db_path = os.path.expanduser("~/.local/share/dankcal/dankcal.db")
    if not os.path.exists(db_path):
        return {}
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cursor = conn.cursor()
        cursor.execute("SELECT id, created FROM tasks")
        created_map = {row[0]: str(row[1]) for row in cursor.fetchall() if row[0] and row[1]}
        conn.close()
        return created_map
    except Exception:
        return {}

def main():
    try:
        cals_proc = subprocess.run(
            ['dcal', 'ipc', 'calendars.list'],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3
        )
        if cals_proc.returncode != 0:
            print(json.dumps({"error": "Failed to fetch calendars", "tasks": [], "pendingCount": 0}))
            return

        cals = json.loads(cals_proc.stdout)
        task_cals = [c for c in cals if c.get('holdsTasks')]
        cal_map = {c['id']: c.get('name') or c.get('accountName') or 'Tasks' for c in task_cals}
        default_cal_id = task_cals[0]['id'] if task_cals else ''

        tasks_proc = subprocess.run(
            ['dcal', 'ipc', 'tasks.list'],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=3
        )
        if tasks_proc.returncode != 0:
            print(json.dumps({"error": "Failed to fetch tasks", "tasks": [], "pendingCount": 0}))
            return

        data = json.loads(tasks_proc.stdout)
        all_tasks = data.get('tasks', [])
        created_map = _get_created_map()

        pending = []
        completed = []
        for t in all_tasks:
            t['calendarName'] = cal_map.get(t.get('calendarId'), 'Tasks')
            if t.get('id') and t.get('id') in created_map:
                t['created'] = created_map[t['id']]
            if t.get('status') == 'completed' or bool(t.get('completed')):
                completed.append(t)
            else:
                pending.append(t)

        def task_sort_key(idx_and_task):
            idx, t = idx_and_task
            p = t.get('priority') or 0
            # 1-9 are high/medium/low priority; 0 is normal (rank 10)
            p_rank = p if (1 <= p <= 9) else 10
            due_raw = t.get('due') or ''
            has_due = 0 if due_raw else 1
            due_val = due_raw if due_raw else '9999-99-99T99:99:99Z'
            created = t.get('created') or t.get('createdAt') or t.get('dtstamp') or ''
            summary = (t.get('summary') or '').strip().lower()
            return (p_rank, has_due, due_val, created, idx, summary)

        indexed_pending = list(enumerate(pending))
        indexed_pending.sort(key=task_sort_key)
        pending = [t for _, t in indexed_pending]

        res = {
            'pending': pending,
            'completed': completed,
            'pendingCount': len(pending),
            'completedCount': len(completed),
            'defaultCalendarId': default_cal_id,
            'taskCalendars': [{'id': c['id'], 'name': c.get('name') or 'Tasks'} for c in task_cals]
        }
        print(json.dumps(res, ensure_ascii=False))

    except Exception as e:
        print(json.dumps({
            "error": str(e),
            "pending": [],
            "completed": [],
            "pendingCount": 0,
            "completedCount": 0,
            "defaultCalendarId": "",
            "taskCalendars": []
        }))

if __name__ == '__main__':
    main()
