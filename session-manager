#!/usr/bin/env python3
"""
session-manager
Manages chat session history (list, get, delete, clear).
"""

import sys
import os
import json
import shutil

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
XDG_DATA_HOME = os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share"))
SESSIONS_DIR = os.path.join(XDG_DATA_HOME, "dms-dankcalendar", "sessions")
os.makedirs(SESSIONS_DIR, mode=0o700, exist_ok=True)

# 自动兼容老版本数据迁移
LEGACY_DIR = os.path.join(SCRIPT_DIR, "data", "sessions")
if os.path.exists(LEGACY_DIR):
    for f in os.listdir(LEGACY_DIR):
        if f.endswith(".json"):
            old_p = os.path.join(LEGACY_DIR, f)
            new_p = os.path.join(SESSIONS_DIR, f)
            if not os.path.exists(new_p):
                try:
                    shutil.copy2(old_p, new_p)
                except Exception:
                    pass

def list_sessions():
    sessions = []
    if os.path.exists(SESSIONS_DIR):
        for fname in os.listdir(SESSIONS_DIR):
            if fname.endswith(".json"):
                path = os.path.join(SESSIONS_DIR, fname)
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        data = json.load(f)
                        sessions.append({
                            "id": data.get("id", fname[:-5]),
                            "title": data.get("title", "未命名会话"),
                            "updatedAt": data.get("updatedAt", ""),
                            "messageCount": len(data.get("messages", []))
                        })
                except Exception:
                    pass
    sessions.sort(key=lambda s: s.get("updatedAt", ""), reverse=True)
    print(json.dumps(sessions, ensure_ascii=False))

def get_session(session_id):
    path = os.path.join(SESSIONS_DIR, f"{session_id}.json")
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                print(f.read())
                return
        except Exception:
            pass
    print(json.dumps({"id": session_id, "title": "新会话", "messages": []}))

def delete_session(session_id):
    path = os.path.join(SESSIONS_DIR, f"{session_id}.json")
    if os.path.exists(path):
        os.remove(path)
    print(json.dumps({"status": "ok"}))

def clear_all():
    if os.path.exists(SESSIONS_DIR):
        for fname in os.listdir(SESSIONS_DIR):
            if fname.endswith(".json"):
                os.remove(os.path.join(SESSIONS_DIR, fname))
    print(json.dumps({"status": "ok"}))

def save_session_data(raw_json):
    try:
        import datetime
        data = json.loads(raw_json)
        session_id = data.get("id")
        if not session_id:
            print(json.dumps({"status": "error", "message": "Missing session id"}))
            return
        safe_id = "".join(c for c in session_id if c.isalnum() or c in ("-", "_"))
        path = os.path.join(SESSIONS_DIR, f"{safe_id}.json")
        if not data.get("updatedAt"):
            data["updatedAt"] = datetime.datetime.now().isoformat()
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        print(json.dumps({"status": "ok"}))
    except Exception as e:
        print(json.dumps({"status": "error", "message": str(e)}))

def main():
    if len(sys.argv) < 2:
        list_sessions()
        return

    cmd = sys.argv[1]
    if cmd == "list":
        list_sessions()
    elif cmd == "get" and len(sys.argv) > 2:
        get_session(sys.argv[2])
    elif cmd == "save":
        raw = sys.argv[2] if len(sys.argv) > 2 else sys.stdin.read()
        save_session_data(raw)
    elif cmd == "delete" and len(sys.argv) > 2:
        delete_session(sys.argv[2])
    elif cmd == "clear":
        clear_all()
    else:
        list_sessions()

if __name__ == "__main__":
    main()
