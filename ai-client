def load_active_provider_from_config(requested_model=None):
    if not os.path.exists(CONFIG_FILE):
        return None, None, None
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            cfg = json.load(f)
            # If user requested a specific model, find which provider owns it!
            if requested_model:
                for p in cfg.get("providers", []):
                    for m in p.get("models", []):
                        if m.get("id") == requested_model:
                            return p.get("baseUrl"), p.get("apiKey"), requested_model
            active_p_id = cfg.get("activeProvider", "agnes")
            active_m_id = cfg.get("activeModel", "agnes-2.5-flash")
            for p in cfg.get("providers", []):
                if p.get("id") == active_p_id:
                    return p.get("baseUrl"), p.get("apiKey"), (requested_model or active_m_id)
    except Exception:
        pass
    return None, None, None

def get_current_time_str():
    now = datetime.datetime.now()
    weekdays = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"]
    weekday_str = weekdays[now.weekday()]
    return f"{now.strftime('%Y-%m-%d %H:%M:%S')} ({weekday_str})"

def get_session_file(session_id):
    safe_id = "".join(c for c in session_id if c.isalnum() or c in ("-", "_"))
    return os.path.join(SESSIONS_DIR, f"{safe_id}.json")

def load_session_history(session_id):
    if not session_id:
        return []
    fpath = get_session_file(session_id)
    if not os.path.exists(fpath):
        return []
    try:
        with open(fpath, "r", encoding="utf-8") as f:
            data = json.load(f)
            return data.get("messages", [])
    except Exception:
        return []

def generate_smart_title(session_id, prompt, proposal, messages):
    existing_title = ""
    fpath = get_session_file(session_id)
    if os.path.exists(fpath):
        try:
            with open(fpath, "r", encoding="utf-8") as f:
                d = json.load(f)
                existing_title = d.get("title", "").strip()
        except Exception:
            pass

    generic_titles = {"新排程会话", "未命名会话", "新会话", "图片排程规划", ""}
    if existing_title and existing_title not in generic_titles:
        is_poor_title = (len(existing_title) <= 4 or existing_title.isdigit() or 
                         existing_title.startswith("帮我") or existing_title.startswith("请帮我") or 
                         existing_title.startswith("已为您安排") or len(existing_title) > 18)
        if not is_poor_title:
            return existing_title

    # 1. Best: LLM directly generated title in proposal JSON (4-8 chars)
    if proposal and isinstance(proposal, dict):
        prop_title = proposal.get("title", "").strip()
        if prop_title:
            clean_t = re.sub(r"^[^\w\u4e00-\u9fa5]+", "", prop_title)
            if 2 <= len(clean_t) <= 16:
                return clean_t

        # 2. Extract from explanation (strip boilerplate phrases)
        exp = proposal.get("explanation", "").strip()
        if exp:
            clean_exp = re.sub(r"^(已为您|已|为您|帮你|已帮您)?(安排|规划|设置|添加|创建|拆解)\s*", "", exp)
            clean_exp = re.sub(r"^[^\w\u4e00-\u9fa5]+", "", clean_exp)
            if len(clean_exp) > 14:
                clean_exp = clean_exp[:14] + "..."
            if len(clean_exp) >= 2:
                return clean_exp

        # 3. Extract from first event title
        events = proposal.get("events", [])
        if events and isinstance(events, list) and len(events) > 0:
            et = events[0].get("title", "").strip()
            if et:
                return et[:14] if len(et) <= 14 else (et[:14] + "...")

    # 4. Extract from first meaningful user message (stripping query prefixes)
    for m in messages:
        if m.get("role") == "user":
            c = m.get("content", "").strip()
            if c and not c.startswith("已附加"):
                clean = c.replace("\n", " ").strip()
                clean = re.sub(r"^(请|麻烦|帮我|请帮我|我想|我要|安排一下|规划一下|设置|创建|分析一下)\s*", "", clean)
                if len(clean) > 14:
                    return clean[:14] + "..."
                elif len(clean) >= 2 and not clean.isdigit():
                    return clean

    # 5. Fallback to prompt
    if prompt:
        clean = prompt.replace("\n", " ").strip()
        clean = re.sub(r"^(请|麻烦|帮我|请帮我|我想|我要|安排一下|规划一下|设置|创建|分析一下)\s*", "", clean)
        return clean[:14] + "..." if len(clean) > 14 else clean

    return "排程规划会话"

def save_session_history(session_id, messages, title=""):
    if not session_id:
        return
    fpath = get_session_file(session_id)
    if not title:
        title = "新排程会话"

    data = {
        "id": session_id,
        "title": title,
        "updatedAt": datetime.datetime.now().isoformat(),
        "messages": messages
    }
    try:
        with open(fpath, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
    except Exception:
        pass

def encode_image(image_path):
    if not image_path or not os.path.exists(image_path):
        return None, None
    mime, _ = mimetypes.guess_type(image_path)
    if not mime:
        mime = "image/png"
    try:
        with open(image_path, "rb") as f:
            b64 = base64.b64encode(f.read()).decode("utf-8")
            return mime, b64
    except Exception:
        return None, None

def emit_event(event_type, payload):
    data = {"type": event_type}
    data.update(payload)
    print(f"data: {json.dumps(data, ensure_ascii=False)}", flush=True)

def create_ssl_context():
    ctx = ssl.create_default_context()
    if os.environ.get("DMS_AI_INSECURE_SSL") == "1":
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    if hasattr(ssl, "OP_IGNORE_UNEXPECTED_EOF"):
        ctx.options |= ssl.OP_IGNORE_UNEXPECTED_EOF
    if hasattr(ssl, "OP_NO_TICKET"):
        ctx.options |= ssl.OP_NO_TICKET
    return ctx

def test_connection(base_url, api_key):
    """Tests API connection and fetches available models."""
    url = f"{base_url.rstrip('/')}/models"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "User-Agent": "DankCalendarPlus/2.0"
    }
    ctx = create_ssl_context()
    try:
        req = urllib.request.Request(url, headers=headers, method="GET")
        with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            models = []
            raw_list = data.get("data", []) if isinstance(data, dict) else data
            for m in raw_list:
                mid = m.get("id") if isinstance(m, dict) else str(m)
                if mid:
                    models.append(mid)
            return {"status": "ok", "models": models}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace") if e.fp else str(e)
        return {"status": "error", "code": e.code, "message": f"HTTP {e.code}: {err_body}"}
    except Exception as e:
        return {"status": "error", "code": 500, "message": str(e)}

def main():
    if len(sys.argv) < 2:
        emit_event("error", {"code": 400, "message": "Missing arguments. Usage: ai-client '<json_request>'"})
        sys.exit(1)

    # Check for test mode
    if sys.argv[1] == "test" and len(sys.argv) >= 4:
        res = test_connection(sys.argv[2], sys.argv[3])
        print(json.dumps(res, ensure_ascii=False))
        return

    try:
        req = json.loads(sys.argv[1])
    except Exception as e:
        emit_event("error", {"code": 400, "message": f"Invalid request JSON: {e}"})
        sys.exit(1)

    model = req.get("model", "").strip()
    api_key = req.get("apiKey", "").strip()
    base_url = req.get("baseUrl", "").strip().rstrip("/")
    prompt = req.get("prompt", "").strip()
    image_path = req.get("imagePath", "").strip()
    file_path = req.get("filePath", "").strip()
    session_id = req.get("sessionId", f"session_{int(datetime.datetime.now().timestamp())}")
    custom_system_prompt = req.get("systemPrompt", "").strip()

    # Route provider dynamically if needed
    cfg_base_url, cfg_api_key, cfg_model = load_active_provider_from_config(model)
    if cfg_base_url:
        base_url = cfg_base_url
    if cfg_api_key:
        api_key = cfg_api_key
    if cfg_model:
        model = cfg_model

    if not base_url:
        base_url = "https://apihub.agnes-ai.com/v1"
    if not model:
        model = "agnes-2.5-flash"

    if not api_key:
        emit_event("error", {
            "code": 401,
            "message": f"未配置 {model} 对应服务商的 API Key。请在 DMS 设置中心中配置该服务商的 API Key。"
        })
        sys.exit(1)

    history = load_session_history(session_id)

    # Read attached file content if any
    attached_file_text = ""
    if file_path and os.path.exists(file_path):
        try:
            with open(file_path, "r", encoding="utf-8", errors="replace") as f:
                attached_file_text = f.read(8000)
        except Exception:
            pass

    current_time_str = get_current_time_str()
    system_text = custom_system_prompt if custom_system_prompt else DEFAULT_SYSTEM_PROMPT
    system_message = {
        "role": "system",
        "content": f"{system_text}\n\n【当前系统精准时间】：{current_time_str}\n请根据此基准时间进行所有相对时间推算（如今天、明天、周五、下周等）。"
    }

    formatted_messages = [system_message]
    recent_history = history[-10:] if len(history) > 10 else history
    for m in recent_history:
        role = m.get("role")
        if role in ("user", "assistant"):
            formatted_messages.append({"role": role, "content": m.get("content", "")})

    # Prepare user content
    user_content = []
    user_text_parts = []
    if prompt:
        user_text_parts.append(prompt)
    if attached_file_text:
        user_text_parts.append(f"\n\n--- 附加文档内容 ({os.path.basename(file_path)}) ---\n{attached_file_text}")

    if user_text_parts:
        user_content.append({"type": "text", "text": "\n".join(user_text_parts)})

    if image_path:
        mime, b64 = encode_image(image_path)
        if b64:
            user_content.append({
                "type": "image_url",
                "image_url": {
                    "url": f"data:{mime};base64,{b64}",
                    "detail": "high"
                }
            })

    if not user_content:
        user_content.append({"type": "text", "text": "帮我规划日程"})

    formatted_messages.append({
        "role": "user",
        "content": user_content if image_path else "\n".join(user_text_parts)
    })

    # Make Streaming POST Request
    url = f"{base_url}/chat/completions"
    payload = {
        "model": model,
        "messages": formatted_messages,
        "stream": True,
        "temperature": 0.3
    }

    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}",
        "User-Agent": "DankCalendarPlus/2.0"
    }

    ctx = create_ssl_context()
    accumulated_response = ""

    try:
        req_obj = urllib.request.Request(url, data=json.dumps(payload).encode("utf-8"), headers=headers, method="POST")
        with urllib.request.urlopen(req_obj, context=ctx, timeout=60) as resp:
            for raw_line in resp:
                line = raw_line.decode("utf-8", errors="replace").strip()
                if not line:
                    continue
                if line.startswith("data:"):
                    data_str = line[5:].strip()
                    if data_str == "[DONE]":
                        break
                    try:
                        chunk = json.loads(data_str)
                        choices = chunk.get("choices", [])
                        if choices:
                            delta = choices[0].get("delta", {})
                            content = delta.get("content", "")
                            if content:
                                accumulated_response += content
                                emit_event("delta", {"content": content})
                    except Exception:
                        continue
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="replace") if e.fp else str(e)
        emit_event("error", {"code": e.code, "message": f"API 错误 ({e.code}): {err_msg}"})
        sys.exit(1)
    except Exception as e:
        emit_event("error", {"code": 500, "message": f"网络连接异常: {str(e)}"})
        sys.exit(1)

    # Extract Proposal if any
    proposal = None
    schedule_block_match = re.search(r"```(?:json:schedule|schedule|json)\s*\n([\s\S]*?)\n```", accumulated_response)
    if schedule_block_match:
        try:
            proposal = json.loads(schedule_block_match.group(1).strip())
        except Exception:
            pass

    # Save to history
    new_history = history.copy()
    new_history.append({
        "role": "user",
        "content": prompt or (f"已附加图片: {os.path.basename(image_path)}" if image_path else "已附加文档"),
        "imagePath": image_path,
        "filePath": file_path,
        "timestamp": datetime.datetime.now().isoformat()
    })
    new_history.append({
        "role": "assistant",
        "content": accumulated_response,
        "proposal": proposal,
        "timestamp": datetime.datetime.now().isoformat()
    })

    # Smart title generation
    session_title = generate_smart_title(session_id, prompt, proposal, new_history)
    save_session_history(session_id, new_history, session_title)

    emit_event("done", {
        "title": session_title,
        "proposal": proposal,
        "fullText": accumulated_response
    })

if __name__ == "__main__":
    main()
