#!/usr/bin/env python3
"""
batch-create-items
Atomically creates multiple events and tasks in dcal via unified TaskService.
Automatically handles date-time formatting, calendar resolution, and LLM auto-tagging.
"""

import sys
import os
import json

ROOT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT_DIR)

from core.lib.task_service import TaskService

def main():
    if len(sys.argv) < 2:
        print(json.dumps({"status": "error", "message": "Missing payload"}))
        sys.exit(1)
    
    raw_input = sys.argv[1]
    try:
        payload = json.loads(raw_input)
    except Exception as e:
        print(json.dumps({"status": "error", "message": f"Invalid JSON: {e}"}))
        sys.exit(1)

    try:
        service = TaskService()
        res = service.batch_create(payload)
        res["status"] = "ok" if res.get("success") else "error"
        print(json.dumps(res, ensure_ascii=False))
    except Exception as e:
        print(json.dumps({"status": "error", "message": str(e)}))
        sys.exit(1)

if __name__ == "__main__":
    main()
