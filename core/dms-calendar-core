#!/usr/bin/env python3
"""
dms-calendar-core
Unified, high-performance CLI backend for Dank Calendar Plus.
"""

import sys
import os
import json
import argparse
import time

# Ensure core package is importable
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from lib.types import StandardResponse
from lib.agenda_service import AgendaService
from lib.task_service import TaskService
from lib.provider_service import ProviderService, PRESET_PROVIDERS
from lib.session_service import SessionService
from lib.ai_service import AiService
from lib.paste_service import PasteService
from lib.tag_service import TagService

def make_ok(data=None, code=200):
    return {
        "status": "ok",
        "code": code,
        "data": data,
        "timestamp": int(time.time())
    }

def make_err(message="Error", code=500, details=None):
    return {
        "status": "error",
        "code": code,
        "error": {
            "code": "CORE_ERROR",
            "message": message,
            "details": details
        },
        "timestamp": int(time.time())
    }

def handle_agenda(args):
    service = AgendaService()
    if args.action == "get":
        events = service.get_agenda_events(past_days=args.past, future_days=args.future)
        print(json.dumps(events, ensure_ascii=False))
    elif args.action == "next":
        next_ev = service.get_next_event(look_ahead_days=args.lookahead, now_window_mins=args.now_window)
        print(json.dumps(next_ev or {}, ensure_ascii=False))

def handle_tasks(args):
    service = TaskService()
    if args.action == "list":
        res = service.get_tasks_summary()
        print(json.dumps(res, ensure_ascii=False))
    elif args.action == "create":
        summary = args.summary or ""
        if args.auto_classify and not TagService.extract_tags(summary):
            c_res = service.classify_task(summary, model_override=args.model)
            if c_res and c_res.get("taggedSummary"):
                summary = c_res["taggedSummary"]
        ok = service.dcal.create_task(args.calendar_id, summary, args.priority, args.due)
        print(json.dumps(make_ok({"created": ok, "summary": summary}) if ok else make_err("Failed to create task")))
    elif args.action == "complete":
        ok = service.dcal.complete_task(args.id, args.completed)
        print(json.dumps(make_ok({"completed": ok}) if ok else make_err("Failed to complete task")))
    elif args.action == "delete":
        ok = service.dcal.delete_task(args.id)
        print(json.dumps(make_ok({"deleted": ok}) if ok else make_err("Failed to delete task")))
    elif args.action == "batch-create":
        try:
            payload = json.loads(args.payload)
            res = service.batch_create(payload)
            print(json.dumps(make_ok(res) if res.get("success") else make_err("Batch create failed", details=str(res.get("errors")))))
        except Exception as e:
            print(json.dumps(make_err(f"Invalid batch payload: {e}")))
    elif args.action == "classify":
        text = args.text or args.summary or ""
        res = service.classify_task(text, model_override=args.model)
        print(json.dumps(make_ok(res), ensure_ascii=False))
    elif args.action == "classify-batch":
        try:
            tasks_list = json.loads(args.payload) if args.payload else None
            res = service.classify_unclassified_tasks(
                tasks_list=tasks_list,
                model_override=args.model,
                include_completed=args.include_completed
            )
            print(json.dumps(make_ok({"tasks": res}), ensure_ascii=False))
        except Exception as e:
            print(json.dumps(make_err(f"Classify batch failed: {e}")))
    elif args.action == "apply-tags":
        try:
            updates = json.loads(args.payload) if args.payload else []
            res = service.apply_tags_updates(updates)
            if res.get("success"):
                print(json.dumps(make_ok(res), ensure_ascii=False))
            else:
                err_detail = "; ".join(res.get("errors", [])) if res.get("errors") else "待办标签写入失败"
                print(json.dumps(make_err("Apply tags failed", details=err_detail), ensure_ascii=False))
        except Exception as e:
            print(json.dumps(make_err(f"Apply tags failed: {e}"), ensure_ascii=False))

def handle_provider(args):
    if args.action == "list":
        cfg = ProviderService.load_config()
        print(json.dumps(make_ok(cfg), ensure_ascii=False))
    elif args.action == "get-presets":
        print(json.dumps(make_ok({"presets": PRESET_PROVIDERS}), ensure_ascii=False))
    elif args.action == "save":
        try:
            prov = json.loads(args.payload)
            ok = ProviderService.save_provider(prov)
            print(json.dumps(make_ok({"saved": ok}) if ok else make_err("Failed to save provider")))
        except Exception as e:
            print(json.dumps(make_err(f"Invalid provider payload: {e}")))
    elif args.action == "delete":
        ok = ProviderService.delete_provider(args.id)
        print(json.dumps(make_ok({"deleted": ok}) if ok else make_err("Failed to delete provider")))
    elif args.action == "set-active":
        ok = ProviderService.set_active(provider_id=args.provider, model_id=args.model)
        print(json.dumps(make_ok({"updated": ok}) if ok else make_err("Failed to set active")))
    elif args.action == "fetch-models":
        res = ProviderService.fetch_models(args.id, custom_base_url=args.base_url, custom_api_key=args.api_key)
        print(json.dumps(res, ensure_ascii=False))
    elif args.action == "benchmark":
        res = ProviderService.benchmark_model(
            model_id=args.model,
            provider_id=args.id,
            custom_base_url=args.base_url,
            custom_api_key=args.api_key
        )
        print(json.dumps(res, ensure_ascii=False))

def handle_session(args):
    if args.action == "list":
        sessions = SessionService.list_sessions()
        print(json.dumps(make_ok({"sessions": sessions}), ensure_ascii=False))
    elif args.action == "get":
        sess = SessionService.get_session(args.id)
        print(json.dumps(make_ok(sess) if sess else make_err("Session not found", code=404), ensure_ascii=False))
    elif args.action == "save":
        try:
            sess = json.loads(args.payload)
            ok = SessionService.save_session(sess)
            print(json.dumps(make_ok({"saved": ok}) if ok else make_err("Failed to save session")))
        except Exception as e:
            print(json.dumps(make_err(f"Invalid session payload: {e}")))
    elif args.action == "delete":
        ok = SessionService.delete_session(args.id)
        print(json.dumps(make_ok({"deleted": ok}) if ok else make_err("Failed to delete session")))
    elif args.action == "smart-title":
        try:
            p_data = json.loads(args.payload) if args.payload else {}
            title = SessionService.generate_smart_title(
                session_id=p_data.get("sessionId", ""),
                prompt=p_data.get("prompt", ""),
                proposal=p_data.get("proposal"),
                messages=p_data.get("messages", [])
            )
            print(json.dumps(make_ok({"title": title}), ensure_ascii=False))
        except Exception as e:
            print(json.dumps(make_err(f"Smart title failed: {e}")))

def handle_ai(args):
    if args.action == "stream":
        try:
            msgs = json.loads(args.messages) if args.messages else []
            AiService.stream_chat(
                messages=msgs,
                model_override=args.model,
                custom_system_prompt=args.system_prompt
            )
        except Exception as e:
            print(json.dumps({"type": "error", "message": str(e)}))

def handle_paste(args):
    path = PasteService.capture_clipboard_image()
    if path:
        print(path)
    else:
        sys.exit(1)

def handle_tag(args):
    if args.action == "list":
        tags = TagService.list_tags()
        print(json.dumps(make_ok({"tags": tags}), ensure_ascii=False))
    elif args.action == "add":
        ok = TagService.add_tag(args.name, color=args.color, icon=args.icon)
        print(json.dumps(make_ok({"added": ok}) if ok else make_err("Failed to add tag")))
    elif args.action == "update":
        ok = TagService.update_tag(int(args.id), name=args.name, color=args.color, icon=args.icon)
        print(json.dumps(make_ok({"updated": ok}) if ok else make_err("Failed to update tag")))
    elif args.action == "delete":
        ok = TagService.delete_tag(args.id or args.name)
        print(json.dumps(make_ok({"deleted": ok}) if ok else make_err("Failed to delete tag")))
    elif args.action == "parse":
        clean, tags = TagService.parse_tags_detail(args.text or "")
        print(json.dumps(make_ok({"cleanText": clean, "tags": tags}), ensure_ascii=False))

def main():
    parser = argparse.ArgumentParser(description="Dank Calendar Plus Core CLI")
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    # Agenda subparser
    p_agenda = subparsers.add_parser("agenda")
    p_agenda.add_argument("action", choices=["get", "next"])
    p_agenda.add_argument("--past", type=int, default=7)
    p_agenda.add_argument("--future", type=int, default=30)
    p_agenda.add_argument("--lookahead", type=int, default=1)
    p_agenda.add_argument("--now-window", type=int, default=5)
    p_agenda.set_defaults(func=handle_agenda)

    # Tasks subparser
    p_tasks = subparsers.add_parser("tasks")
    p_tasks.add_argument("action", choices=["list", "create", "complete", "delete", "batch-create", "classify", "classify-batch", "apply-tags"])
    p_tasks.add_argument("--calendar-id", default="")
    p_tasks.add_argument("--summary", default="")
    p_tasks.add_argument("--text", default="")
    p_tasks.add_argument("--priority", type=int, default=0)
    p_tasks.add_argument("--due", default=None)
    p_tasks.add_argument("--id", default="")
    p_tasks.add_argument("--completed", type=lambda v: v.lower() == "true", default=True)
    p_tasks.add_argument("--include-completed", action="store_true", default=False)
    p_tasks.add_argument("--auto-classify", action="store_true", default=False)
    p_tasks.add_argument("--model", default=None)
    p_tasks.add_argument("--payload", default="")
    p_tasks.set_defaults(func=handle_tasks)

    # Provider subparser
    p_provider = subparsers.add_parser("provider")
    p_provider.add_argument("action", choices=["list", "get-presets", "save", "delete", "set-active", "fetch-models", "benchmark"])
    p_provider.add_argument("--id", default="")
    p_provider.add_argument("--base-url", default=None)
    p_provider.add_argument("--api-key", default=None)
    p_provider.add_argument("--provider", default=None)
    p_provider.add_argument("--model", default=None)
    p_provider.add_argument("--payload", default="")
    p_provider.set_defaults(func=handle_provider)

    # Session subparser
    p_session = subparsers.add_parser("session")
    p_session.add_argument("action", choices=["list", "get", "save", "delete", "smart-title"])
    p_session.add_argument("--id", default="")
    p_session.add_argument("--payload", default="")
    p_session.set_defaults(func=handle_session)

    # AI subparser
    p_ai = subparsers.add_parser("ai")
    p_ai.add_argument("action", choices=["stream"])
    p_ai.add_argument("--messages", default="[]")
    p_ai.add_argument("--model", default=None)
    p_ai.add_argument("--system-prompt", default=None)
    p_ai.set_defaults(func=handle_ai)

    # Paste subparser
    p_paste = subparsers.add_parser("paste")
    p_paste.set_defaults(func=handle_paste)

    # Tag subparser
    p_tag = subparsers.add_parser("tag")
    p_tag.add_argument("action", choices=["list", "add", "update", "delete", "parse"])
    p_tag.add_argument("--id", default="")
    p_tag.add_argument("--name", default="")
    p_tag.add_argument("--color", default=None)
    p_tag.add_argument("--icon", default=None)
    p_tag.add_argument("--text", default="")
    p_tag.set_defaults(func=handle_tag)

    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
