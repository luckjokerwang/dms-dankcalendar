def load_config():
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except Exception:
        pass
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG
    try:
        os.chmod(CONFIG_FILE, 0o600)
    except Exception:
        pass
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            if not isinstance(data, dict):
                return DEFAULT_CONFIG
            if "providers" not in data or not isinstance(data["providers"], list):
                data["providers"] = []
            return data
    except Exception:
        return DEFAULT_CONFIG

def save_config(data):
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    try:
        os.chmod(CONFIG_FILE, 0o600)
    except Exception:
        pass

def get_ssl_context():
    ctx = ssl.create_default_context()
    if os.environ.get("DMS_AI_INSECURE_SSL") == "1":
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    return ctx

def cmd_get_presets():
    print(json.dumps({"status": "ok", "presets": PRESET_PROVIDERS}, ensure_ascii=False))

def cmd_list():
    cfg = load_config()
    print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))

def cmd_set_active(provider_id, model_id=None):
    cfg = load_config()
    found = False
    for p in cfg.get("providers", []):
        if p.get("id") == provider_id:
            found = True
            cfg["activeProvider"] = provider_id
            if model_id:
                cfg["activeModel"] = model_id
            elif p.get("models") and len(p["models"]) > 0:
                cfg["activeModel"] = p["models"][0].get("id", model_id)
            break
    if not found and model_id:
        cfg["activeModel"] = model_id
    save_config(cfg)
    print(json.dumps({
        "status": "ok",
        "activeProvider": cfg.get("activeProvider"),
        "activeModel": cfg.get("activeModel"),
        "data": cfg
    }, ensure_ascii=False))

def cmd_save_provider(p_json_str):
    cfg = load_config()
    try:
        p_data = json.loads(p_json_str)
    except Exception as e:
        print(json.dumps({"status": "error", "message": f"Invalid JSON: {e}"}))
        return
    p_id = p_data.get("id")
    if not p_id:
        print(json.dumps({"status": "error", "message": "Missing provider id"}))
        return
    
    existing_idx = -1
    for i, p in enumerate(cfg.get("providers", [])):
        if p.get("id") == p_id:
            existing_idx = i
            break
            
    if existing_idx >= 0:
        cfg["providers"][existing_idx].update(p_data)
    else:
        cfg["providers"].append(p_data)
        
    save_config(cfg)
    print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))

def cmd_delete_provider(provider_id):
    cfg = load_config()
    cfg["providers"] = [p for p in cfg.get("providers", []) if p.get("id") != provider_id]
    if cfg.get("activeProvider") == provider_id and len(cfg["providers"]) > 0:
        cfg["activeProvider"] = cfg["providers"][0]["id"]
        if cfg["providers"][0].get("models") and len(cfg["providers"][0]["models"]) > 0:
            cfg["activeModel"] = cfg["providers"][0]["models"][0]["id"]
    save_config(cfg)
    print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))

def parse_models_from_response(raw_bytes):
    try:
        data = json.loads(raw_bytes.decode("utf-8"))
    except Exception:
        return []

    model_ids = []
    # 1. Standard OpenAI format: {"data": [{"id": "gpt-4o"}, ...]}
    if isinstance(data, dict) and "data" in data and isinstance(data["data"], list):
        for item in data["data"]:
            if isinstance(item, dict) and "id" in item:
                model_ids.append(item["id"])
            elif isinstance(item, str):
                model_ids.append(item)
    # 2. Ollama / Gemini format: {"models": [{"name": "llama3.2"}, ...]}
    elif isinstance(data, dict) and "models" in data and isinstance(data["models"], list):
        for item in data["models"]:
            if isinstance(item, dict):
                mid = item.get("id") or item.get("name") or item.get("model")
                if mid:
                    model_ids.append(mid)
            elif isinstance(item, str):
                model_ids.append(item)
    # 3. Direct array format: [{"id": "..."}, ...]
    elif isinstance(data, list):
        for item in data:
            if isinstance(item, dict) and "id" in item:
                model_ids.append(item["id"])
            elif isinstance(item, str):
                model_ids.append(item)

    # Filter out obvious non-chat models (embedding, audio, tts, moderation, image-gen only)
    exclude_keywords = ["embedding", "embed", "tts", "whisper", "dall-e", "moderation", "rerank", "bge-", "clip-"]
    filtered = []
    for mid in model_ids:
        lower = mid.lower()
        if any(k in lower for k in exclude_keywords):
            continue
        filtered.append(mid)

    # De-duplicate while preserving order
    seen = set()
    result = []
    for m in filtered:
        if m not in seen:
            seen.add(m)
            result.append(m)

    return result

def cmd_fetch_models(provider_id):
    cfg = load_config()
    target = None
    for p in cfg.get("providers", []):
        if p.get("id") == provider_id:
            target = p
            break
            
    if not target:
        print(json.dumps({"status": "error", "message": f"Provider '{provider_id}' 未找到"}))
        return

    base_url = target.get("baseUrl", "").rstrip("/")
    api_key = target.get("apiKey", "").strip()
    if not base_url:
        print(json.dumps({"status": "error", "message": "Base URL 为空"}))
        return

    models_url = f"{base_url}/models"
    headers = {
        "User-Agent": "DankCalendar/2.1",
        "Accept": "application/json"
    }
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    req = urllib.request.Request(models_url, headers=headers)
    ctx = get_ssl_context()

    start_time = time.time()
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
            raw = resp.read()
            latency = int((time.time() - start_time) * 1000)
            models = parse_models_from_response(raw)
            if not models:
                # If parsing produced 0, but status 200, add a fallback generic model
                models = [f"{provider_id}-default"]

            model_objects = [{"id": mid, "name": mid, "desc": "实时同步模型"} for mid in models]
            target["models"] = model_objects
            if cfg.get("activeProvider") == provider_id:
                if not cfg.get("activeModel") or cfg.get("activeModel") not in models:
                    cfg["activeModel"] = models[0]

            save_config(cfg)
            print(json.dumps({
                "status": "ok",
                "latency": latency,
                "count": len(models),
                "models": model_objects,
                "activeModel": cfg.get("activeModel"),
                "data": cfg
            }, ensure_ascii=False))
    except urllib.error.HTTPError as e:
        print(json.dumps({"status": "error", "message": f"HTTP {e.code}: {e.reason}", "latency": -1}))
    except Exception as e:
        print(json.dumps({"status": "error", "message": f"连接失败: {str(e)}", "latency": -1}))

def cmd_test(provider_id_or_url, api_key=None):
    base_url = ""
    key = ""
    if api_key is not None:
        base_url = provider_id_or_url.rstrip("/")
        key = api_key.strip()
    else:
        cfg = load_config()
        for p in cfg.get("providers", []):
            if p.get("id") == provider_id_or_url:
                base_url = p.get("baseUrl", "").rstrip("/")
                key = p.get("apiKey", "").strip()
                break

    if not base_url:
        print(json.dumps({"status": "error", "message": "未找到端点 URL", "latency": -1}))
        return

    url = f"{base_url}/models"
    headers = {
        "User-Agent": "DankCalendar/2.1",
        "Accept": "application/json"
    }
    if key:
        headers["Authorization"] = f"Bearer {key}"

    req = urllib.request.Request(url, headers=headers)
    ctx = get_ssl_context()

    start_time = time.time()
    try:
        with urllib.request.urlopen(req, context=ctx, timeout=8) as resp:
            raw = resp.read()
            latency = int((time.time() - start_time) * 1000)
            models = parse_models_from_response(raw)
            print(json.dumps({
                "status": "ok",
                "latency": latency,
                "modelCount": len(models),
                "models": models[:10]
            }, ensure_ascii=False))
    except urllib.error.HTTPError as e:
        print(json.dumps({"status": "error", "message": f"HTTP {e.code}: {e.reason}", "latency": -1}))
    except Exception as e:
        print(json.dumps({"status": "error", "message": f"连接异常: {str(e)}", "latency": -1}))

def main():
    if len(sys.argv) < 2:
        cmd_list()
        return

    cmd = sys.argv[1]
    if cmd == "list":
        cmd_list()
    elif cmd == "get-presets":
        cmd_get_presets()
    elif cmd == "set-active":
        p_id = sys.argv[2] if len(sys.argv) > 2 else "agnes"
        m_id = sys.argv[3] if len(sys.argv) > 3 else None
        cmd_set_active(p_id, m_id)
    elif cmd == "fetch-models":
        if len(sys.argv) > 2:
            cmd_fetch_models(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "Missing provider id"}))
    elif cmd == "save-provider":
        raw = sys.argv[2] if len(sys.argv) > 2 else sys.stdin.read()
        cmd_save_provider(raw)
    elif cmd == "delete-provider":
        if len(sys.argv) > 2:
            cmd_delete_provider(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "Missing provider id"}))
    elif cmd == "test":
        if len(sys.argv) >= 4:
            cmd_test(sys.argv[2], sys.argv[3])
        elif len(sys.argv) >= 3:
            cmd_test(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "Missing test target"}))
    else:
        cmd_list()

if __name__ == "__main__":
    main()
