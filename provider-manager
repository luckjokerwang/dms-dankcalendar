def load_config():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        save_config(DEFAULT_PROVIDERS)
        return DEFAULT_PROVIDERS
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        return DEFAULT_PROVIDERS

def save_config(data):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

def cmd_list():
    cfg = load_config()
    print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))

def cmd_set_active(provider_id, model_id=None):
    cfg = load_config()
    found = False
    for p in cfg.get("providers", []):
        if p["id"] == provider_id:
            found = True
            cfg["activeProvider"] = provider_id
            if model_id:
                cfg["activeModel"] = model_id
            elif p.get("models") and len(p["models"]) > 0:
                cfg["activeModel"] = p["models"][0]["id"]
            break
    if not found and model_id:
        cfg["activeModel"] = model_id
    save_config(cfg)
    print(json.dumps({"status": "ok", "activeProvider": cfg.get("activeProvider"), "activeModel": cfg.get("activeModel")}, ensure_ascii=False))

def cmd_save_provider(p_json_str):
    cfg = load_config()
    try:
        p_data = json.loads(p_json_str)
    except Exception as e:
        print(json.dumps({"status": "error", "message": f"Invalid JSON: {e}"}))
        return
    p_id = p_data.get("id")
    if not p_id:
        print(json.dumps({"status": "error", "message": "Missing provider id"}))
        return
    
    # Update existing or add new
    existing_idx = -1
    for i, p in enumerate(cfg.get("providers", [])):
        if p["id"] == p_id:
            existing_idx = i
            break
            
    if existing_idx >= 0:
        cfg["providers"][existing_idx].update(p_data)
    else:
        if "providers" not in cfg:
            cfg["providers"] = []
        cfg["providers"].append(p_data)
        
    save_config(cfg)
    print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))

def cmd_add_model(provider_id, model_id, model_name=None, desc=None):
    cfg = load_config()
    for p in cfg.get("providers", []):
        if p["id"] == provider_id:
            models = p.get("models", [])
            for m in models:
                if m["id"] == model_id:
                    m["name"] = model_name or model_id
                    if desc:
                        m["desc"] = desc
                    save_config(cfg)
                    print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))
                    return
            models.append({
                "id": model_id,
                "name": model_name or model_id,
                "desc": desc or "自定义模型"
            })
            p["models"] = models
            save_config(cfg)
            print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))
            return
    print(json.dumps({"status": "error", "message": f"Provider {provider_id} not found"}))

def cmd_delete_model(provider_id, model_id):
    cfg = load_config()
    for p in cfg.get("providers", []):
        if p["id"] == provider_id:
            p["models"] = [m for m in p.get("models", []) if m["id"] != model_id]
            save_config(cfg)
            print(json.dumps({"status": "ok", "data": cfg}, ensure_ascii=False))
            return
    print(json.dumps({"status": "error", "message": f"Provider {provider_id} not found"}))

def cmd_test(base_url, api_key):
    url = base_url.rstrip("/") + "/models"
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {api_key}",
        "User-Agent": "DankCalendar/2.0"
    })
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            models = []
            if "data" in data and isinstance(data["data"], list):
                for item in data["data"]:
                    if isinstance(item, dict) and "id" in item:
                        models.append(item["id"])
            print(json.dumps({"status": "ok", "models": models}, ensure_ascii=False))
    except Exception as e:
        print(json.dumps({"status": "error", "message": str(e)}, ensure_ascii=False))

def main():
    if len(sys.argv) < 2:
        cmd_list()
        return
    cmd = sys.argv[1]
    if cmd == "list":
        cmd_list()
    elif cmd == "set-active":
        p_id = sys.argv[2] if len(sys.argv) > 2 else "agnes"
        m_id = sys.argv[3] if len(sys.argv) > 3 else None
        cmd_set_active(p_id, m_id)
    elif cmd == "save-provider":
        if len(sys.argv) > 2:
            cmd_save_provider(sys.argv[2])
    elif cmd == "add-model":
        if len(sys.argv) >= 4:
            p_id = sys.argv[2]
            m_id = sys.argv[3]
            m_name = sys.argv[4] if len(sys.argv) > 4 else m_id
            m_desc = sys.argv[5] if len(sys.argv) > 5 else ""
            cmd_add_model(p_id, m_id, m_name, m_desc)
    elif cmd == "delete-model":
        if len(sys.argv) >= 4:
            cmd_delete_model(sys.argv[2], sys.argv[3])
    elif cmd == "test":
        if len(sys.argv) >= 4:
            cmd_test(sys.argv[2], sys.argv[3])
    else:
        cmd_list()

if __name__ == "__main__":
    main()
